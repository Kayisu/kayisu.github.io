---
import '../styles/global.css';
import { SITE } from '../data/site';
import type { ProjectPalette } from '../data/palettes';
import { LOCALES, getDictionary, localeMeta, type Locale } from '../i18n';

export interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  canonicalPath?: string;
  alternatePaths?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  robots?: string;
  ogType?: 'website' | 'article';
  bodyClass?: string;
  skin?: ProjectPalette;
}

const {
  locale = 'tr',
  canonicalPath = Astro.url.pathname,
  alternatePaths,
  noindex = false,
  robots = 'noindex, nofollow',
  ogType = 'website',
  bodyClass,
  skin,
} = Astro.props;

const dictionary = getDictionary(locale);
const title = Astro.props.title ?? dictionary.metadata.landingTitle;
const description = Astro.props.description ?? dictionary.metadata.landingDescription;
const siteUrl = Astro.site ?? new URL(SITE.url);
const canonicalUrl = new URL(canonicalPath, siteUrl);
const completeAlternates = alternatePaths
  ? LOCALES.map((alternateLocale) => {
      const path = alternatePaths[alternateLocale];
      return path ? { locale: alternateLocale, href: new URL(path, siteUrl).toString() } : undefined;
    }).filter((entry): entry is { locale: Locale; href: string } => Boolean(entry))
  : [];
const hasTrueLanguagePair = completeAlternates.length === LOCALES.length;
const defaultAlternate = completeAlternates.find((entry) => entry.locale === 'tr');
const fontSpec = skin?.font.googleSpec ?? 'Rubik:wght@400;500';
const bodyStyle = skin
  ? `--page-bg:${skin.bg};--page-surface:${skin.surface};--page-text:${skin.text};--page-muted:${skin.muted};--page-accent:${skin.accent};--page-radius:${skin.radius}px;--page-font:'${skin.font.family}',sans-serif;`
  : undefined;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang} data-skin={skin ? 'project' : 'shell'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.toString()} />
    {noindex && <meta name="robots" content={robots} />}
    {hasTrueLanguagePair && completeAlternates.map(({ locale: alternateLocale, href }) => (
      <link rel="alternate" hreflang={localeMeta[alternateLocale].htmlLang} href={href} />
    ))}
    {hasTrueLanguagePair && defaultAlternate && (
      <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    {hasTrueLanguagePair && completeAlternates.filter(({ locale: other }) => other !== locale).map(({ locale: other }) => (
      <meta property="og:locale:alternate" content={localeMeta[other].ogLocale} />
    ))}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=${fontSpec}&display=swap`} />
  </head>
  <body class:list={[bodyClass, skin ? 'project-body' : 'shell-body']} style={bodyStyle}>
    <slot />
  </body>
</html>
