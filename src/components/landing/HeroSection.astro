---
import SolarApp from '../solar/SolarApp';
import type { SolarBody, SolarCopy } from '../solar/SolarApp';
import { SITE } from '../../data/site';
import {
  explorePath,
  getDictionary,
  sectionPath,
  type Locale,
} from '../../i18n';

interface Props {
  locale: Locale;
  bodies: SolarBody[];
  copy: SolarCopy;
}

const { locale, bodies, copy } = Astro.props;
const dictionary = getDictionary(locale);
---

<section class="landing-hero site-container" aria-labelledby="landing-title">
  <div class="landing-hero__copy">
    <p class="section-eyebrow">{dictionary.hero.eyebrow}</p>
    <h1 id="landing-title">{SITE.name}</h1>
    <p class="landing-hero__statement">{dictionary.hero.statement}</p>
    <p class="landing-hero__introduction">{dictionary.hero.introduction}</p>

    <div class="landing-hero__actions">
      <a class="button button--primary" href={sectionPath(locale, 'projects')}>
        {dictionary.hero.viewProjects}
      </a>
      <a class="button button--secondary" href={explorePath(locale)}>
        {dictionary.hero.exploreSystem}
      </a>
      <a class="button button--quiet" href={SITE.github} target="_blank" rel="noopener noreferrer">
        {dictionary.contact.github}
        <span class="visually-hidden"> — {dictionary.accessibility.externalLink}</span>
      </a>
    </div>
  </div>

  <div class="landing-hero__visual">
    <SolarApp mode="hero" bodies={bodies} copy={copy} client:only="react">
      <div slot="fallback" class="solar-prehydrate" role="status">
        <p>{copy.loadingLabel}</p>
        <a href="#categories">{copy.unavailableMessage}</a>
      </div>
    </SolarApp>
  </div>
</section>

<style>
  .landing-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(24rem, 1.14fr);
    align-items: center;
    min-height: calc(100dvh - 4.75rem);
    padding-block: clamp(3.5rem, 8vw, 7rem);
    gap: clamp(2.5rem, 6vw, 5.5rem);
  }

  .landing-hero__copy {
    max-width: 39rem;
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(3.25rem, 8vw, 6.8rem);
    line-height: 0.92;
    letter-spacing: -0.065em;
  }

  .landing-hero__statement {
    margin-top: 1.6rem;
    color: var(--color-text-primary);
    font-size: clamp(1.25rem, 2.4vw, 1.85rem);
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .landing-hero__introduction {
    max-width: 34rem;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.7;
  }

  .landing-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }

  .landing-hero__visual {
    position: relative;
    min-width: 0;
  }

  .landing-hero__visual :global(astro-island) {
    display: block;
    min-height: 24rem;
  }

  @media (max-width: 900px) {
    .landing-hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-block: 4rem;
    }

    .landing-hero__copy {
      max-width: 46rem;
    }
  }

  @media (max-width: 520px) {
    h1 {
      font-size: clamp(3rem, 17vw, 4.5rem);
    }

    .landing-hero__actions,
    .button {
      width: 100%;
    }
  }
</style>
