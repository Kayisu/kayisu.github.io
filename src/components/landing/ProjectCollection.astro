---
import ProjectCard from '../projects/ProjectCard.astro';
import { getDictionary, type Locale } from '../../i18n';
import type { ProjectEntry } from '../../lib/projects';

interface Props {
  id: string;
  locale: Locale;
  eyebrow: string;
  title: string;
  description: string;
  entries: readonly ProjectEntry[];
}

const { id, locale, eyebrow, title, description, entries } = Astro.props;
const dictionary = getDictionary(locale);
---

<section id={id} class="project-collection section-block" aria-labelledby={`${id}-title`}>
  <div class="site-container">
    <header class="section-heading">
      <p class="section-eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`}>{title}</h2>
      <p>{description}</p>
    </header>

    {
      entries.length > 0 ? (
        <ul class="project-collection__grid">
          {entries.map((entry) => (
            <li>
              <ProjectCard
                entry={entry}
                statusLabel={dictionary.status[entry.data.status]}
                categoryLabel={dictionary.solar.bodies[entry.data.planet].category}
                ctaLabel={dictionary.common.readMore}
                tagsLabel={dictionary.project.technologies}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="project-collection__empty">{dictionary.project.noProjectsDescription}</p>
      )
    }
  </div>
</section>

<style>
  .project-collection:nth-of-type(even) {
    background: var(--color-surface-muted);
    border-block: 1px solid var(--color-border-subtle);
  }

  .project-collection__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .project-collection__empty {
    padding: 1.5rem;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px dashed var(--color-border-subtle);
    border-radius: 1rem;
  }
</style>
