---
import { SITE } from '../../data/site';
import { homePath, type Locale, type LocalisedRoute } from '../../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  languageHref?: string;
  languageRoute?: LocalisedRoute;
}

const { locale, languageHref, languageRoute } = Astro.props;
---

<header class="site-header">
  <a class="site-header__wordmark" href={homePath(locale)}>{SITE.name}</a>
  <LanguageSwitcher locale={locale} href={languageHref} route={languageRoute} />
</header>
