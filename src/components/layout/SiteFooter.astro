---
import { SITE } from '../../data/site';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
---

<footer class="site-footer">
  <nav class="site-footer__contacts" aria-label={dictionary.contact.email}>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <span class="site-footer__separator" aria-hidden="true">·</span>
    <a href={SITE.github} target="_blank" rel="noopener noreferrer">
      {dictionary.contact.github}<span class="visually-hidden"> — {dictionary.accessibility.externalLink}</span>
    </a>
    <span class="site-footer__separator" aria-hidden="true">·</span>
    <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
      {dictionary.contact.linkedin}<span class="visually-hidden"> — {dictionary.accessibility.externalLink}</span>
    </a>
  </nav>
</footer>
