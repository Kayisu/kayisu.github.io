---
import {
  getDictionary,
  homePath,
  otherLocale,
  resolveEquivalentPath,
  type Locale,
  type LocalisedRoute,
} from '../../i18n';

interface Props {
  locale: Locale;
  href?: string;
  route?: LocalisedRoute;
}

const { locale, href, route } = Astro.props;
const targetLocale = otherLocale(locale);
const dictionary = getDictionary(locale);
const currentHref = locale === 'tr' && href === '/' ? homePath('en') : href;
const destination = currentHref ?? (route ? resolveEquivalentPath(route, targetLocale) : homePath(targetLocale));
---

<a class="site-header__language" href={destination} lang={targetLocale} hreflang={targetLocale} aria-label={dictionary.language.switchTo}>
  {dictionary.language.shortTarget}
</a>
