---
import { EARTH_GAMES } from '../../data/games';
import { earthGamesPath, getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
---

<section class="earth-games" aria-labelledby="earth-games-title">
  <div class="earth-games__heading">
    <div>
      <p class="earth-games__eyebrow">{dictionary.solar.bodies.earth.category}</p>
      <h2 id="earth-games-title">{dictionary.planet.gamesTitle}</h2>
      <p>{dictionary.planet.gamesDescription}</p>
    </div>
    <a class="earth-games__index-link" href={earthGamesPath(locale)}>
      {dictionary.planet.exploreGames} <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <ul class="earth-games__grid">
    {
      EARTH_GAMES.map((game) => (
        <li>
          <a class="earth-games__card" href={game.href}>
            <div class="earth-games__card-top">
              <h3>{game.title}</h3>
              <span>{game.status}</span>
            </div>
            <p>{game.summary}</p>
            <span class="earth-games__play">
              {dictionary.common.open} <span aria-hidden="true">&rarr;</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .earth-games {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--card-border);
  }

  .earth-games__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .earth-games__eyebrow {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .earth-games h2 {
    font-size: 1.6rem;
    margin-bottom: 0.4rem;
  }

  .earth-games__heading p:last-child,
  .earth-games__card > p {
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .earth-games__index-link,
  .earth-games__play {
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
  }

  .earth-games__index-link {
    white-space: nowrap;
  }

  .earth-games__grid {
    list-style: none;
  }

  .earth-games__card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem;
    color: var(--text-primary);
    text-decoration: none;
    background: linear-gradient(135deg, rgba(73, 132, 255, 0.1), var(--card-bg));
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--card-border));
    border-radius: 14px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .earth-games__card:hover,
  .earth-games__card:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .earth-games__card-top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .earth-games__card-top h3 {
    font-size: 1.15rem;
  }

  .earth-games__card-top > span {
    padding: 0.25rem 0.55rem;
    color: #c9a8ff;
    border: 1px solid rgba(201, 168, 255, 0.35);
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .earth-games__heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
