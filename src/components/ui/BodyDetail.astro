---
import type { Body } from '../../data/planets';
import {
  getDictionary,
  type CelestialBodyId,
  type Locale,
} from '../../i18n';
import { getProjectIndex, type ProjectPlanet } from '../../lib/projects';
import EarthGamesSection from '../games/EarthGamesSection.astro';
import SiteFooter from '../layout/SiteFooter.astro';
import SiteHeader from '../layout/SiteHeader.astro';
import ProjectCard from '../projects/ProjectCard.astro';

interface Props {
  body: Body;
  locale: Locale;
  languageHref: string;
}

const { body, locale, languageHref } = Astro.props;
const dictionary = getDictionary(locale);
const bodyCopy = dictionary.solar.bodies[body.name as CelestialBodyId];
const accent = `#${body.color.toString(16).padStart(6, '0')}`;
const projects = (await getProjectIndex()).forPlanet(locale, body.name as ProjectPlanet);
const countLabel = projects.length === 1
  ? dictionary.planet.projectCount
  : dictionary.planet.projectCountPlural;
---

<SiteHeader locale={locale} languageHref={languageHref} />
<main id="main-content" class="planet-page" style={`--accent: ${accent};`}>
  <div class="planet-page-shell">
    <header class="planet-page-header">
      <p class="planet-page-eyebrow">{dictionary.planet.categoryLabel} · {bodyCopy.category}</p>
      <h1>{bodyCopy.name}</h1>
      <p class="planet-page-description">{bodyCopy.description}</p>
      {projects.length > 0 && (
        <p class="planet-project-count">{projects.length} {countLabel}</p>
      )}
    </header>

    {
      projects.length > 0 ? (
        <section aria-labelledby="planet-projects-title">
          <h2 id="planet-projects-title" class="section-title">{dictionary.project.projects}</h2>
          <ul class="planet-project-grid">
            {projects.map((entry) => (
              <li>
                <ProjectCard
                  entry={entry}
                  statusLabel={dictionary.status[entry.data.status]}
                  categoryLabel={bodyCopy.category}
                  ctaLabel={dictionary.common.readMore}
                  tagsLabel={dictionary.project.technologies}
                />
              </li>
            ))}
          </ul>
        </section>
      ) : body.name === 'earth' && locale === 'tr' ? (
        <section class="earth-games-discovery" aria-labelledby="earth-games-discovery-title">
          <p class="planet-page-eyebrow">{dictionary.planet.gamesTitle}</p>
          <h2 id="earth-games-discovery-title">{dictionary.planet.earthEmptyWithGames}</h2>
          <p>{dictionary.planet.gamesDescription}</p>
          <a href="/planet/earth/games/">
            {dictionary.planet.exploreGames} <span aria-hidden="true">→</span>
          </a>
        </section>
      ) : body.name !== 'earth' ? (
        <section class="planet-empty-state" aria-labelledby="empty-state-title">
          <h2 id="empty-state-title">{dictionary.project.noProjectsTitle}</h2>
          <p>{dictionary.project.noProjectsDescription}</p>
        </section>
      ) : null
    }

    {body.name === 'earth' && locale === 'en' && <EarthGamesSection />}
  </div>
</main>
<SiteFooter locale={locale} />

<style>
  .planet-page {
    min-height: 100vh;
    padding: clamp(6rem, 10vw, 8rem) 1.25rem 5rem;
    background: var(--color-page, var(--bg-color));
  }

  .planet-page-shell {
    width: min(100%, 70rem);
    margin: 0 auto;
  }

  .planet-page-header {
    max-width: 46rem;
    margin-bottom: 3.5rem;
  }

  .planet-page-eyebrow {
    margin-bottom: 0.65rem;
    color: var(--color-accent, var(--accent));
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(3rem, 10vw, 6.5rem);
    line-height: 0.95;
  }

  .planet-page-description {
    max-width: 38rem;
    margin-top: 1rem;
    color: var(--color-text-secondary, var(--text-secondary));
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    line-height: 1.6;
  }

  .planet-project-count {
    margin-top: 1rem;
    color: var(--color-text-muted, var(--text-secondary));
    font-size: 0.85rem;
  }

  .section-title {
    margin-bottom: 1.25rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  .planet-project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .planet-empty-state,
  .earth-games-discovery {
    padding: clamp(1.4rem, 4vw, 2rem);
    background: var(--color-surface, var(--card-bg));
    border: 1px solid var(--color-border-subtle, var(--card-border));
    border-radius: 1rem;
  }

  .planet-empty-state h2,
  .earth-games-discovery h2 {
    font-size: clamp(1.25rem, 3vw, 1.6rem);
  }

  .planet-empty-state p,
  .earth-games-discovery > p:not(.planet-page-eyebrow) {
    max-width: 40rem;
    margin-top: 0.6rem;
    color: var(--color-text-secondary, var(--text-secondary));
    line-height: 1.6;
  }

  .earth-games-discovery a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: 1.2rem;
    color: var(--color-accent, var(--accent));
    font-weight: 650;
    text-decoration: none;
  }

  .earth-games-discovery a:focus-visible {
    outline: 3px solid var(--color-focus, var(--accent));
    outline-offset: 3px;
  }
</style>
