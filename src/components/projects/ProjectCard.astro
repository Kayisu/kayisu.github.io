---
import { Image } from 'astro:assets';
import type { ProjectEntry } from '../../lib/projects';
import { projectHref } from '../../lib/projects';

interface Props {
  entry: ProjectEntry;
  statusLabel: string;
  categoryLabel?: string;
  ctaLabel?: string;
  tagsLabel?: string;
  kindLabel?: string;
}

const { entry, statusLabel, categoryLabel, ctaLabel, tagsLabel, kindLabel } = Astro.props;
const { cover, kind, period, role, tags, title, summary, status, year } = entry.data;
---

<article class="project-card-item">
  <a class="project-card-link" href={projectHref(entry)}>
    {
      cover && (
        <div class="project-card-media">
          <Image src={cover.src} alt={cover.alt} widths={[480, 720, 960]} sizes="(max-width: 720px) 100vw, 33vw" />
        </div>
      )
    }
    <div class="project-card-body">
      <div class="project-card-heading">
        <div>
          {categoryLabel && <p class="project-card-category">{categoryLabel}</p>}
          <h3>{title}</h3>
        </div>
        <span class={`status-badge status-${status}`}>{statusLabel}</span>
      </div>

      <p class="project-card-summary">{summary}</p>

      {kind && kindLabel && <span class="project-kind-chip">{kindLabel}</span>}

      {(period || year || role) && (
        <p class="project-card-context">
          {[period ?? year?.toString(), role].filter(Boolean).join(' · ')}
        </p>
      )}

      {tags && tags.length > 0 && (
        <ul class="tag-list" aria-label={tagsLabel}>
          {tags.map((tag) => <li class="tag-pill">{tag}</li>)}
        </ul>
      )}

      {ctaLabel && (
        <span class="project-card-cta">
          {ctaLabel} <span aria-hidden="true">→</span>
        </span>
      )}
    </div>
  </a>
</article>

<style>
  .project-card-item,
  .project-card-link {
    height: 100%;
  }

  .project-card-link {
    display: flex;
    overflow: hidden;
    flex-direction: column;
    color: var(--color-text-primary, var(--text-primary));
    text-decoration: none;
    background: var(--color-surface, var(--card-bg));
    border: 1px solid var(--color-border-subtle, var(--card-border));
    border-radius: 1rem;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .project-card-link:hover,
  .project-card-link:focus-visible {
    border-color: var(--color-accent, var(--accent));
    box-shadow: 0 0.75rem 2rem rgb(18 26 34 / 12%);
    transform: translateY(-0.2rem);
  }

  .project-card-link:focus-visible {
    outline: 3px solid var(--color-focus, var(--accent));
    outline-offset: 3px;
  }

  .project-card-media {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-muted, var(--card-bg));
  }

  .project-card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.35rem;
  }

  .project-card-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .project-card-category {
    margin-bottom: 0.3rem;
    color: var(--color-accent, var(--accent));
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .project-card-summary,
  .project-card-context {
    color: var(--color-text-secondary, var(--text-secondary));
    line-height: 1.55;
  }

  .project-card-summary {
    flex: 1;
  }

  .project-card-context {
    font-size: 0.82rem;
  }

  .project-kind-chip {
    width: fit-content;
    padding: 0.25rem 0.55rem;
    color: var(--color-text-secondary, var(--text-secondary));
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--color-surface-muted, var(--card-bg));
    border: 1px solid var(--color-border-subtle, var(--card-border));
    border-radius: 999px;
  }

  .project-card-cta {
    color: var(--color-accent, var(--accent));
    font-size: 0.88rem;
    font-weight: 650;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card-link {
      transition: none;
    }

    .project-card-link:hover,
    .project-card-link:focus-visible {
      transform: none;
    }
  }
</style>
