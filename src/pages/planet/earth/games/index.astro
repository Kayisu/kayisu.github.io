---
import SiteFooter from '../../../../components/layout/SiteFooter.astro';
import SiteHeader from '../../../../components/layout/SiteHeader.astro';
import { EARTH_GAMES } from '../../../../data/games';
import type { LocalisedRoute } from '../../../../i18n';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const locale = 'en' as const;
const route = { kind: 'earth-games' } satisfies LocalisedRoute;
---

<BaseLayout
  title="Earth Games | Kayisu"
  description="Interactive browser experiments from the Earth playground."
  locale={locale}
  canonicalPath="/planet/earth/games/"
>
  <SiteHeader locale={locale} languageRoute={route} />
  <main id="main-content" class="games-page">
    <nav class="games-page__navigation" aria-label="Games navigation">
      <a href="/planet/earth/"><span aria-hidden="true">←</span> Back to Earth</a>
    </nav>

    <header class="games-page__header">
      <p>Earth / Playground</p>
      <h1>Games</h1>
      <p>Small browser experiments, each with its own static page.</p>
    </header>

    <ul class="games-page__grid">
      {
        EARTH_GAMES.map((game) => (
          <li>
            <article class="games-page__card">
              <div class="games-page__card-heading">
                <h2>{game.title}</h2>
                <span>{game.status}</span>
              </div>
              <p>{game.summary}</p>
              <ul aria-label={`${game.title} controls`}>
                {game.controls.map((control) => <li>{control}</li>)}
              </ul>
              <a href={game.href}>Open {game.title} <span aria-hidden="true">→</span></a>
            </article>
          </li>
        ))
      }
    </ul>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .games-page {
    min-height: 100vh;
    padding: clamp(2rem, 5vw, 4rem) 1.25rem clamp(4rem, 8vw, 7rem);
    background:
      radial-gradient(circle at 75% 15%, var(--color-accent-soft), transparent 34rem),
      var(--color-page);
  }

  .games-page__navigation,
  .games-page__header,
  .games-page__grid {
    width: min(100%, 60rem);
    margin-inline: auto;
  }

  .games-page__navigation a,
  .games-page__card > a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--color-accent-hover);
    font-weight: 700;
    text-decoration: none;
  }

  .games-page__header {
    padding: clamp(4rem, 10vw, 7rem) 0 2.5rem;
  }

  .games-page__header > p:first-child {
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .games-page__header h1 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(3rem, 9vw, 5.5rem);
    line-height: 1;
  }

  .games-page__header > p:last-child,
  .games-page__card > p,
  .games-page__card ul {
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .games-page__grid {
    display: grid;
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .games-page__card {
    display: grid;
    gap: 1.2rem;
    padding: clamp(1.4rem, 4vw, 2rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: 1rem;
  }

  .games-page__card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .games-page__card-heading span {
    color: var(--color-accent-hover);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .games-page__card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-left: 1.1rem;
  }
</style>
