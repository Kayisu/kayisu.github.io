---
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const locale = 'en' as const;
---

<BaseLayout
  title="Lost in space | Kayisu"
  description="The requested page could not be found."
  locale={locale}
  canonicalPath="/404.html"
  noindex
>
  <SiteHeader locale={locale} />
  <main id="main-content" class="not-found-page">
    <div>
      <p class="not-found-page__eyebrow">Error 404</p>
      <h1>Lost in space</h1>
      <p>This corner of the galaxy does not exist. Return to the portfolio and continue exploring.</p>
      <a class="button button--primary" href="/">
        <span aria-hidden="true">←</span> Back to the portfolio
      </a>
    </div>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .not-found-page {
    display: grid;
    min-height: min(46rem, calc(100dvh - 4.75rem));
    place-items: center;
    padding: clamp(5rem, 12vw, 9rem) 1.25rem;
  }

  .not-found-page > div {
    width: min(100%, 40rem);
    text-align: center;
  }

  .not-found-page__eyebrow {
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 0.65rem;
    font-size: clamp(3.5rem, 12vw, 7rem);
    letter-spacing: -0.06em;
  }

  .not-found-page p:not(.not-found-page__eyebrow) {
    max-width: 34rem;
    margin: 1rem auto 0;
    color: var(--color-text-secondary);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .not-found-page .button {
    margin-top: 1.75rem;
  }
</style>
