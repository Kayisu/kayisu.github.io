---
import SiteFooter from '../components/layout/SiteFooter.astro';
import { getDictionary } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

const trCopy = getDictionary('tr').notFound;
const enCopy = getDictionary('en').notFound;
---

<BaseLayout title="Sayfa bulunamadı | Page not found" canonicalPath="/404.html" noindex>
  <main class="not-found-page">
    <p lang="tr">{trCopy.message}</p>
    <p lang="en">{enCopy.message}</p>
    <a href="/">← {trCopy.home} / {enCopy.home}</a>
  </main>
  <SiteFooter locale="tr" />
</BaseLayout>

<style>
  .not-found-page { display: grid; place-content: center; gap: 10px; min-height: 70vh; padding: 2rem; text-align: center; }
  .not-found-page p { font-size: clamp(18px, 4vw, 24px); }
  .not-found-page a { justify-self: center; margin-top: 10px; color: var(--page-muted); font-size: 14px; text-underline-offset: 3px; }
</style>
