---
import ProjectCaseStudy from '../../../components/projects/ProjectCaseStudy.astro';
import { getBody } from '../../../data/planets';
import {
  getAlternatePaths,
  getDictionary,
  otherLocale,
  projectPath,
  resolveEquivalentPath,
  type LocalisedRoute,
} from '../../../i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjectIndex, type ProjectEntry } from '../../../lib/projects';

export async function getStaticPaths() {
  const projectIndex = await getProjectIndex();
  return projectIndex.forLocale('tr').map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: ProjectEntry;
}

const locale = 'tr' as const;
const { entry }: Props = Astro.props;
const projectIndex = await getProjectIndex();
const translation = projectIndex.translationOf(entry, otherLocale(locale));
const route = {
  kind: 'project',
  slugs: {
    ...(translation ? { en: translation.data.slug } : {}),
    tr: entry.data.slug,
  },
} satisfies LocalisedRoute;
const body = getBody(entry.data.planet)!;
const accent = `#${body.color.toString(16).padStart(6, '0')}`;
const dictionary = getDictionary(locale);
---

<BaseLayout
  title={`${entry.data.title} · ${dictionary.metadata.projectsTitle}`}
  description={entry.data.summary}
  locale={locale}
  canonicalPath={projectPath(locale, entry.data.slug)}
  alternatePaths={getAlternatePaths(route)}
  ogType="article"
>
  <ProjectCaseStudy
    entry={entry}
    body={body}
    locale={locale}
    languageHref={resolveEquivalentPath(route, otherLocale(locale))}
    accent={accent}
    neighbours={projectIndex.neighboursOf(entry)}
  />
</BaseLayout>
