---
import BodyDetail from '../../../components/ui/BodyDetail.astro';
import { PLANETS, getBody } from '../../../data/planets';
import {
  getAlternatePaths,
  getDictionary,
  otherLocale,
  planetPath,
  resolveEquivalentPath,
  type CelestialBodyId,
  type LocalisedRoute,
} from '../../../i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return PLANETS.map((planet) => ({ params: { name: planet.name } }));
}

const locale = 'tr' as const;
const { name } = Astro.params;
const body = getBody(name!)!;
const dictionary = getDictionary(locale);
const bodyCopy = dictionary.solar.bodies[body.name as CelestialBodyId];
const planetName = body.name as Exclude<CelestialBodyId, 'sun'>;
const route = { kind: 'planet', name: planetName } satisfies LocalisedRoute;
const canonicalPath = planetPath(locale, planetName);
const languageHref = resolveEquivalentPath(route, otherLocale(locale));
---

<BaseLayout
  title={`${bodyCopy.name} · ${dictionary.metadata.planetTitleSuffix}`}
  description={bodyCopy.description}
  locale={locale}
  canonicalPath={canonicalPath}
  alternatePaths={getAlternatePaths(route)}
>
  <BodyDetail body={body} locale={locale} languageHref={languageHref} />
</BaseLayout>
