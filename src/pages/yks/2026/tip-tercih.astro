---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import YksApp from '../../../components/yks/YksApp';
import SiteFooter from '../../../components/layout/SiteFooter.astro';
import SiteHeader from '../../../components/layout/SiteHeader.astro';
import { excluded, manifest, validation, validateYksDataset } from '../../../data/yks';
import '../../../styles/yks.css';

validateYksDataset();
const { counts } = manifest;
const number = new Intl.NumberFormat('tr-TR');
const title = '2026 YKS Tıp Tercih Sihirbazı';
const description = 'ÖSYM 2026 Tablo 4 verilerinden üretilmiş, aday sırasına göre nesnel fark hesaplayan Tıp tercih listesi aracı.';
const summary = [
  [counts.eligiblePrograms, 'uygun Tıp programı'],
  [counts.public, 'devlet programı'],
  [counts.foundation, 'vakıf programı'],
  [counts.trnc, 'KKTC programı'],
  [counts.withClosingRank, '2025 kapanışı bulunan'],
  [counts.newWithoutHistory + counts.unfilled2025, 'kapanış hesabına katılmayan'],
];
---

<BaseLayout title={title} description={description} locale="tr">
  <SiteHeader locale="tr" languageHref="/" />
  <main id="main-content" class="yks-shell">
    <header class="yks-header">
      <p class="yks-eyebrow">2026 YKS · Resmî Tablo 4 verisi</p>
      <h1>2026 Tıp Tercih Sihirbazı</h1>
      <p class="yks-lede">Aday sıralamanızı girin, uygun sivil Tıp programlarını filtreleyin ve en fazla 24 tercihlik listenizi gerçek istek sıranıza göre oluşturun.</p>
    </header>

    <div class="yks-warning">
      <strong>Bu araç tahmin, olasılık veya yerleşme garantisi üretmez.</strong>
      <p>Gösterilen tek karşılaştırma <code>2025 kapanış sırası − aday sırası</code> farkıdır. Pozitif fark adayın geçen yılki kapanışın önünde, negatif fark gerisinde olduğunu anlatır. Yeni veya 2025’te dolmayan programlar bu hesaba katılmaz.</p>
      <p>Tercih göndermeden önce program kodunu, özel koşulları, ücreti ve burs devam şartlarını ÖSYM AİS ile üniversitenin güncel duyurusundan yeniden doğrulayın.</p>
    </div>

    <ul class="yks-summary">{summary.map(([value, label]) => <li><strong>{number.format(Number(value))}</strong><span>{label}</span></li>)}</ul>

    <YksApp client:only="react" />

    <section class="yks-method">
      <h2>Veri kapsamı ve doğrulama</h2>
      <p>Birincil veri, ÖSYM Tablo 4 XLS dosyasındaki {counts.table4MedicineRows} Tıp satırından üretilmiştir. Koşul 5 kapsamındaki {counts.excludedKktcCitizenOnly} yalnız-KKTC-uyruklu kontenjan ile {counts.excludedMilitaryMinistry} askerî/bakanlık alımı çıkarılmış; sivil Gülhane ve diğer sivil SBÜ programları korunmuştur.</p>
      <p>{validation.invariants.allProgramCodesFoundInPdf ? '225 program kodunun tamamı PDF metin katmanında bulundu.' : 'PDF kod eşleştirmesinde eksik var.'} Kullanılan tüm özel koşullar PDF’nin “Koşul ve Açıklamalar” bölümünden programa bağlanmıştır. Boş hücre, <code>...</code>, <code>----</code> ve gerçek sıfır birbirine dönüştürülmez.</p>
      <details><summary>Dışarıda bırakılan 17 satırı göster</summary><ul class="yks-excluded-list">{excluded.map((item) => <li><strong>{item.programCode}</strong> · {item.universityName} · {item.program}<br />{item.reason}</li>)}</ul></details>
    </section>

    <section class="yks-source-panel">
      <h2>Kaynak kaydı</h2>
      <dl><div><dt>Veri sürümü</dt><dd>{manifest.datasetVersion}</dd></div><div><dt>Birincil kaynak</dt><dd>{manifest.primarySource.file} · {manifest.primarySource.sheet}!{manifest.primarySource.range}</dd></div><div><dt>XLS SHA-256</dt><dd><code>{manifest.primarySource.sha256}</code></dd></div><div><dt>PDF doğrulama kaynağı</dt><dd>{manifest.validationSource.file} · {manifest.validationSource.pages} sayfa</dd></div><div><dt>PDF SHA-256</dt><dd><code>{manifest.validationSource.sha256}</code></dd></div></dl>
    </section>
  </main>
  <SiteFooter locale="tr" />
</BaseLayout>

<style is:global>
  .yks-tabs {
    top: 5rem;
  }
</style>
